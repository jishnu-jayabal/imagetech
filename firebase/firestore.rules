rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return request.auth.token.role;
    }
    
    function getUserBranch() {
      return request.auth.token.branchId;
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'super_admin';
    }

    function isBranchManager(branchId) {
      return isAuthenticated() && getUserRole() == 'branch_manager' && getUserBranch() == branchId;
    }

    function isAssignedTechnician(techId) {
      return isAuthenticated() && request.auth.uid == techId;
    }

    // Branches Collection
    match /branches/{branchId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Technicians Collection
    match /technicians/{techId} {
      allow read: if isAuthenticated();
      allow create, delete: if isSuperAdmin() || isBranchManager(request.resource.data.branchId);
      allow update: if isSuperAdmin() || 
                       isBranchManager(resource.data.branchId) || 
                       (isAssignedTechnician(techId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLocation', 'batteryLevel', 'status']));
    }

    // Jobs Collection
    match /jobs/{jobId} {
      // Customers can read their specific job via tokenized SMS link without logging in
      allow read: if isAuthenticated() || 
                     (resource.data.trackingToken != null && request.query.token == resource.data.trackingToken);
      
      // Branch Managers can create and edit jobs in their branch
      allow create: if isSuperAdmin() || isBranchManager(request.resource.data.branchId);
      
      // Managers can update estimates, assign technicians, close jobs
      // Technicians can update status, stream location, add additionalCharges, upload photos
      allow update: if isSuperAdmin() || 
                       isBranchManager(resource.data.branchId) || 
                       isAssignedTechnician(resource.data.technicianId);
      
      allow delete: if isSuperAdmin();
    }

    // Real-Time Telemetry Pings
    match /telemetry/{telemetryId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
    }
  }
}
